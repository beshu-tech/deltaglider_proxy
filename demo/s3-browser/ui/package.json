{
  "name": "deltaglider-s3-browser",
  "private": true,
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync:screenshots": "node scripts/copy-screenshots.mjs",
    "predev": "node scripts/copy-screenshots.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-screenshots.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:strict": "eslint 'src/**/*.{ts,tsx}' --max-warnings 0",
    "test": "vitest",
    "test:all": "vitest run",
    "e2e": "playwright test",
    "e2e:qa": "QA_REGRESSION=1 playwright test e2e/qa-regression.spec.ts",
    "typecheck": "tsc --noEmit",
    "knip": "knip"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.1044.0",
    "@aws-sdk/s3-request-presigner": "^3.988.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.100.1",
    "@tanstack/react-virtual": "^3.14.4",
    "antd": "^6.3.0",
    "mermaid": "^11.14.0",
    "minisearch": "^7.2.0",
    "motion": "^12.38.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.73.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "30.1.1",
    "knip": "^6.18.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.1.0",
    "vitest": "5.0.2",
    "yaml": "2.9.0"
  }
}
