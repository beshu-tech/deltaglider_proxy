---
// /pricing — calculator React island + static tier cards, both fed by
// the single source of truth in src/lib/brackets.ts.
//
// The model (licensing 2.0): free under the 15 TB Stored Footprint grant,
// one flat Commercial plan per organization up to 1 PB, Enterprise above
// 1 PB or for custom terms, and an OEM row for hosted services and
// embedding in a product.
//
// JSON-LD Offers are generated from SCHEMA_OFFER_BRACKETS (the
// fixed-price paid tiers only) — Enterprise and OEM are excluded (no fixed price).

import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import PricingCalculator from '../components/PricingCalculator';
import {
  webPageSchema,
  breadcrumbListSchema,
  pricingProductSchema,
} from '../lib/seo';
import { BRACKETS, SCHEMA_OFFER_BRACKETS, FREE_GRANT_TB } from '../lib/brackets';
import '../styles/calculator.css';

const title = 'Pricing — DeltaGlider';
const description =
  `Free up to ${FREE_GRANT_TB} TB of compressed data. One flat Commercial plan at $5k/year per organization covers the license, support, and signed builds. The calculator shows annual savings live.`;

// Schema generator wants {sku, name, price, description}. Adapt from
// the rich Bracket shape — single source of truth lives in brackets.ts.
const schemaTiers = SCHEMA_OFFER_BRACKETS.map((b) => ({
  sku: `deltaglider-${b.id}`,
  name: b.name,
  price: String(b.priceUsd),
  description: b.description,
}));

const freeTiers = BRACKETS.filter((b) => b.id === 'free' || b.id === 'trial');
const commercialTiers = BRACKETS.filter((b) => b.id === 'commercial');
const customTiers = BRACKETS.filter((b) => b.id === 'enterprise' || b.id === 'oem');

/**
 * Special-case the trial-row description so the in-table link
 * to /trial keeps working. brackets.ts holds plain text only.
 */
function renderDescription(id: string, description: string): string {
  let html = description;
  if (id === 'trial') {
    html = html.replace(
      'See /trial',
      'See <a href="/trial">/trial</a>',
    );
  }

  // Highlight the grant threshold and absorb the surrounding phrase
  html = html.replace(/([0-9]+ TB of compressed stored data)/, '<span class="pr-highlight">$1</span>');

  return html;
}
---

<BaseLayout title={title} description={description}>
  <Fragment slot="json-ld">
    <JsonLd schema={webPageSchema({ path: '/pricing', title, description })} />
    <JsonLd
      schema={breadcrumbListSchema([
        { name: 'DeltaGlider', path: '/' },
        { name: 'Pricing', path: '/pricing' },
      ])}
    />
    <JsonLd schema={pricingProductSchema(schemaTiers)} />
  </Fragment>

    <section class="calculator-hero shell">
      <div class="calculator-hero-inner measure-wide">
        <h1>What does DeltaGlider save you?</h1>
        <p>
          Type the numbers from your current AWS S3 bill and get an answer in 30
          seconds, even when the answer is no. We don't ask for your email.
        </p>
      </div>
    </section>

    <section class="calculator-section shell" id="calculator">
      <div class="calculator-container">
        <PricingCalculator client:load />
      </div>
    </section>

  <div class="shell">
    <section class="tiers">
      <h2>What you'd pay</h2>

      <h3>Free & evaluation</h3>
      <div class="pricing-stack">
        {
          freeTiers.map((b) => {
            return (
              <div class="pricing-row">
                <div class="pr-tier">
                  <h4 class="tier-title">{b.name}</h4>
                </div>
                <div class="pr-price">
                  <span class="price-val">{b.priceLabel}</span>
                </div>
                <div class="pr-desc" set:html={renderDescription(b.id, b.description)} />
              </div>
            );
          })
        }
      </div>

      <h3 class="tiers-commercial-header">Commercial</h3>
      <div class="pricing-stack">
        {
          commercialTiers.map((b) => {
            return (
              <div class="pricing-row pricing-row-commercial">
                <div class="pr-tier">
                  <h4 class="tier-title">{b.name}</h4>
                </div>
                <div class="pr-price">
                  <span class="price-val">{b.priceLabel}</span>
                </div>
                <div class="pr-desc" set:html={renderDescription(b.id, b.description)} />
              </div>
            );
          })
        }
      </div>

      <h3>Enterprise & OEM</h3>
      <div class="pricing-stack">
        {
          customTiers.map((b) => {
            return (
              <div class="pricing-row">
                <div class="pr-tier">
                  <h4 class="tier-title">{b.name}</h4>
                </div>
                <div class="pr-price">
                  <span class="price-val">{b.priceLabel}</span>
                </div>
                <div class="pr-desc" set:html={renderDescription(b.id, b.description)} />
              </div>
            );
          })
        }
      </div>
    </section>

    <section class="meter">
      <h2>What we mean by "stored footprint"</h2>

      <p>
        The stored footprint is the number of bytes that all of your
        organization's production deployments of DeltaGlider cause to be
        stored, measured after DeltaGlider's compression. It counts every
        copy that DeltaGlider writes: the primary data, the replicas and
        archives that DeltaGlider writes to other buckets or regions, and
        the reference and metadata objects that delta compression needs.
        Your source (logical) bytes, ingress, and egress don't count.
      </p>

      <p>
        Bytes that your storage provider keeps for its own redundancy do
        not count, because DeltaGlider does not write them. For example,
        when you turn on S3 cross-region replication in your provider's
        console, the provider makes that copy, so it is not part of your
        footprint. When DeltaGlider's own replication writes the copy, it
        is.
      </p>

      <p>
        The footprint is the average over a calendar month of one
        measurement a day, so a short spike does not push you over the
        line. Your organization is you together with every company that
        controls you, that you control, or that is under common control
        with you, where control means more than 50% of the voting shares.
      </p>

      <p>
        We don't collect telemetry and the software never phones home.
        The admin dashboard and the <code>/_/stats</code> endpoint of each
        deployment show the compressed bytes that it stores, so you can
        add them up and see which side of the {FREE_GRANT_TB} TB line you
        are on. You self-report, and we cross-check against the
        <code>/_/stats</code> endpoint only if you give us read access
        during the conversation.
      </p>
    </section>

    <section class="commercial">
      <h2>When do you need a paid license?</h2>

      <p>
        DeltaGlider is source-available under the
        <a href="https://github.com/beshu-tech/deltaglider_proxy/blob/main/LICENSE">Business Source License 1.1</a>.
        The license grants free production use to most organizations,
        and every release becomes Apache-2.0 open source two years after
        it ships. You need a paid license only if one of these applies:
      </p>

      <ul>
        <li>
          Your organization's stored footprint exceeds {FREE_GRANT_TB} TB.
          Up to 1 PB, this is the Commercial plan, at the flat published
          price above. One plan covers the whole organization, with any
          number of instances, clusters and regions.
        </li>
        <li>
          Your organization's stored footprint exceeds 1 PB, or you need
          custom terms such as indemnity, a security review, or
          procurement paperwork. That is the Enterprise plan.
        </li>
        <li>
          You offer DeltaGlider, or a service whose primary value comes
          from it, to third parties as a hosted, managed or multi-tenant
          service. That needs an OEM license.
        </li>
        <li>
          You ship DeltaGlider inside or with a commercial product or
          appliance. That needs an OEM license too, and it covers your
          customers' use of the copy you ship them. Without it, the free
          grant does not cover those customers.
        </li>
      </ul>

      <p>
        Everything else is free: production use under the grant, and
        development, testing, and evaluation at any size. If your
        footprint is above {FREE_GRANT_TB} TB, the calculator above shows
        how the savings compare with the plan price.
      </p>

      <p>
        <a href="mailto:sales@beshu.tech?subject=DeltaGlider%20-%20Enterprise%20or%20OEM%20inquiry">
          Talk to sales about Enterprise or OEM
        </a>
      </p>
    </section>

    <section class="faq">
      <div class="faq-header">
        <h2>Frequently asked</h2>
      </div>

      <div class="faq-grid">
        <div class="faq-item">
          <h3>Is DeltaGlider still open source?</h3>
          <p>
            DeltaGlider is source-available. You can read and build every
            line of the public source, and there are no license keys. The
            license doesn't meet the OSI definition of open source. Every
            release automatically becomes Apache-2.0, an open source
            license, two years after it ships. Releases up to v1.17.0
            were GPL-3.0 and stay GPL-3.0 forever.
          </p>
        </div>

        <div class="faq-item">
          <h3>Why one flat price instead of brackets?</h3>
          <p>
            Support effort doesn't scale with your bytes, and charging
            more the better the compression works taxed the product for
            doing its job. Above the free grant and up to 1 PB, every
            organization gets the same plan, with the license, support,
            and signed builds all included. The price is per
            organization, not per deployment, so a new cluster or region
            does not add to it. If your savings are $200k/yr, good: the
            price stays $5k.
          </p>
        </div>

        <div class="faq-item">
          <h3>Why is the plan $5k? That feels high for "support."</h3>
          <p>
            Support is only part of what you pay for. The $5k buys the
            license above the {FREE_GRANT_TB} TB grant, an SLA on critical
            infrastructure, and a direct email line to the engineers who
            wrote the proxy. The calculator above shows what DeltaGlider
            saves you at your size, compared with the plan price.
          </p>
        </div>

        <div class="faq-item">
          <h3>What happens if I cross the {FREE_GRANT_TB} TB line mid-year?</h3>
          <p>
            Nothing breaks and no feature switches off. The software keeps
            working, and the admin dashboard shows your footprint, so you
            can see when the monthly average crosses the line. At that
            point you buy the Commercial plan. The proxy doesn't phone home, and we send no
            surprise invoices.
          </p>
        </div>

        <div class="faq-item">
          <h3>Replication doubles my footprint. Do you count it twice?</h3>
          <p>
            Yes, when DeltaGlider writes the copy. The license counts every
            stored copy that DeltaGlider writes, so a bucket that
            DeltaGlider replicates to a second region counts twice. The
            redundancy that your storage provider runs by itself, such as
            S3 cross-region replication that you turn on at the provider,
            does not count, because DeltaGlider does not write those bytes.
          </p>
        </div>

        <div class="faq-item">
          <h3>What counts as my organization?</h3>
          <p>
            Your organization is your company together with every company
            that controls it, that it controls, or that is under common
            control with it. Control means more than 50% of the voting
            shares. So a parent company and its subsidiaries share one
            {FREE_GRANT_TB} TB grant and need one Commercial plan, not one
            for each subsidiary.
          </p>
        </div>

        <div class="faq-item">
          <h3>We run DeltaGlider for a client. Do we need OEM?</h3>
          <p>
            No, if you run it for one client inside infrastructure that
            the client controls. The license treats that as the client's
            own production use, so the client's footprint and the client's
            plan apply. You need OEM when you run DeltaGlider as a hosted,
            managed or multi-tenant service that you offer to third
            parties.
          </p>
        </div>

        <div class="faq-item">
          <h3>We ship a product that includes DeltaGlider</h3>
          <p>
            Then you need an OEM license. The free grant does not cover a
            copy of DeltaGlider that a customer received as part of a
            commercial product or appliance, unless the vendor holds an OEM
            license that covers that use. The OEM license covers your
            customers, so they do not each need their own plan.
          </p>
        </div>

        <div class="faq-item">
          <h3>What about a migration that briefly doubles a bucket?</h3>
          <p>
            The footprint is the average over a calendar month of one
            measurement a day. A migration that holds two copies of a
            bucket raises the average only for the days that both copies
            exist. For example, a second copy that exists for 3 days of a
            30-day month adds a tenth of the bucket's size to that month's
            footprint.
          </p>
        </div>

        <div class="faq-item">
          <h3>I'm under the grant. Do I still get the trial?</h3>
          <p>
            Yes. The 30-day trial gives you the Commercial plan's support
            regardless of your size, so you can try it before you need
            it. See <a href="/trial">/trial</a>.
          </p>
        </div>

        <div class="faq-item">
          <h3>How do I get a real compression number on my own data?</h3>
          <p>
            Run
            <code>docker run --rm -it -p 9000:9000 -v dgp-data:/data -e DGP_AUTHENTICATION=none beshultd/deltaglider_proxy</code>,
            copy a sample of your data in, and read the Delta Efficiency
            Panel at <code>/_/admin/diagnostics/delta-efficiency</code>.
            No data leaves your network. Or talk to us and we'll help you
            set it up.
          </p>
        </div>

        <div class="faq-item">
          <h3>What does it cost in speed?</h3>
          <p>
            The compute tax lands on writes, once: delta encoding makes a
            single-stream upload roughly twelve times slower, on the CI
            path, where nobody waits on it. Reads pay about 30% on time
            to first byte when cold and nothing when warm. Encryption is
            effectively free. The measured numbers and the methodology
            are in
            <a href="/docs/explanation/the-compute-tax">the compute tax</a>.
          </p>
        </div>

        <div class="faq-item">
          <h3>What stops me from just using the free grant forever?</h3>
          <p>
            Nothing, if you stay under it. The grant exists so that small
            teams, homelabs, and startups never pay. Above it, the license
            text itself requires a commercial license. The software doesn't
            enforce that, so whether you honor it is a question for your
            compliance process.
          </p>
        </div>
      </div>
    </section>

    <section class="cta">
      <h2>Get started</h2>

      <div class="hero-ctas">
        <a href="/trial" class="btn btn-primary">Start a 30-day trial</a>
        <a href="/docs/tutorials/first-delta-savings" class="btn">Run it free</a>
        <a
          href="mailto:sales@beshu.tech?subject=DeltaGlider%20-%20Sales%20inquiry"
          class="btn"
        >
          Talk to sales
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .tiers,
  .meter,
  .commercial,
  .faq,
  .cta {
    margin: 3rem 0;
  }

  /* === FAQ Redesign === */
  .faq-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .faq-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3.5rem 3rem;
    }
  }

  .faq-item {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ink-strong);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .faq-item p {
    margin: 0;
    font-size: 1rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .faq-item a {
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--brand-line-soft);
    transition: text-decoration-color 0.2s ease;
  }

  .faq-item a:hover {
    text-decoration-color: var(--brand);
  }

  .faq-item code {
    background: var(--surface-tint-strong);
    padding: 0.15rem 0.3rem;
    border-radius: 4px;
    font-size: 0.85em;
    color: var(--ink);
  }

  /* === Calculator Section === */
  .calculator-hero {
    /* Block padding only: the .shell class owns the side gutters. */
    padding-block: 6rem 8rem; /* Extra padding at bottom for the overlapping calculator */
    text-align: center;
    background: radial-gradient(circle at 50% -20%, var(--brand-tint), transparent 60%),
                var(--bg);
    border-bottom: 1px solid var(--rule); /* Establish a solid "hero line" */
  }

  .calculator-hero-inner {
    margin: 0 auto;
  }

  /* The global p rule caps width at the measure and anchors left; this
     hero is centered, so the paragraph must center too. */
  .calculator-hero-inner p {
    margin-inline: auto;
  }

  .calculator-hero h1 {
    font-size: 3rem;
    margin-top: 3rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
    color: var(--ink-strong);
  }

  .calculator-hero p {
    font-size: 1.15rem;
    color: var(--ink-soft);
  }

  .calculator-section {
    padding-bottom: 4rem;
  }

  @media (max-width: 599px) {
    .calculator-hero {
      padding-block: 1rem 6.5rem;
      text-align: left;
    }
    .calculator-hero h1 {
      font-size: 2.1rem;
      line-height: 1.1;
    }
    .calculator-hero-inner p {
      margin-inline: 0;
      font-size: 1.05rem;
    }
  }

  .calculator-container {
    margin: -5rem auto 0; /* Pull up over the hero section */
    max-width: 1040px; /* Make it significantly wider than measure-wide */
    position: relative;
    z-index: 10;
  }

  /* === Tiers Layout === */
  .tiers h3 {
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-size: 1.15rem;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.5rem;
  }
  
  .tiers h3.tiers-commercial-header {
    color: var(--brand);
    border-bottom-color: var(--brand-soft);
  }

  .tier-title {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 700;
    color: var(--ink-strong);
    letter-spacing: -0.01em;
  }

  /* === Pricing Stack Redesign === */
  .pricing-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }

  .pricing-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    background: var(--bg-card);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    padding: 1.5rem;
  }

  @media (min-width: 768px) {
    .pricing-row {
      grid-template-columns: 2fr 1.6fr 4fr;
      align-items: center;
      gap: 2rem;
      padding: 1.75rem 2rem;
    }
  }

  /* Prices in the body face, never wrapping. */
  .pr-price .price-val {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--ink-strong);
    white-space: nowrap;
  }

  .pr-desc {
    font-size: 1rem;
    color: var(--ink-soft);
    line-height: 1.55;
    margin: 0;
  }

  .pr-desc :global(.pr-highlight) {
    color: var(--ink-strong);
    font-weight: 600;
  }

  /* The one published paid plan: a brand border, not a top stripe. */
  .pricing-row-commercial {
    border-color: var(--brand);
  }
  .pricing-row-commercial .price-val { color: var(--brand); }
</style>
