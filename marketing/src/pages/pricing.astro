---
// /pricing — calculator React island + static tier cards, both fed by
// the single source of truth in src/lib/brackets.ts.
//
// The model (since the BUSL-1.1 relicense): free under the 15 TB
// compressed-footprint grant, one flat Commercial plan above it, and
// an OEM row for embedding / hosted-service resale.
//
// JSON-LD Offers are generated from SCHEMA_OFFER_BRACKETS (the
// fixed-price paid tiers only) — OEM is excluded (no fixed price).

import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import PricingCalculator from '../components/PricingCalculator';
import {
  webPageSchema,
  breadcrumbListSchema,
  pricingProductSchema,
} from '../lib/seo';
import { BRACKETS, SCHEMA_OFFER_BRACKETS, FREE_GRANT_TB } from '../lib/brackets';
import '../styles/calculator.css';

const title = 'Pricing — DeltaGlider';
const description =
  `Free up to ${FREE_GRANT_TB} TB of compressed data. One flat Commercial plan at $5k/year covers the license, support, and signed builds. The calculator shows annual savings live.`;

// Schema generator wants {sku, name, price, description}. Adapt from
// the rich Bracket shape — single source of truth lives in brackets.ts.
const schemaTiers = SCHEMA_OFFER_BRACKETS.map((b) => ({
  sku: `deltaglider-${b.id}`,
  name: b.name,
  price: String(b.priceUsd),
  description: b.description,
}));

const freeTiers = BRACKETS.filter((b) => b.id === 'free' || b.id === 'trial');
const commercialTiers = BRACKETS.filter((b) => b.id === 'commercial');
const customTiers = BRACKETS.filter((b) => b.id === 'oem');

/**
 * Special-case the trial-row description so the in-table link
 * to /trial keeps working. brackets.ts holds plain text only.
 */
function renderDescription(id: string, description: string): string {
  let html = description;
  if (id === 'trial') {
    html = html.replace(
      'See /trial',
      'See <a href="/trial">/trial</a>',
    );
  }

  // Highlight the grant threshold and absorb the surrounding phrase
  html = html.replace(/([0-9]+ TB of compressed stored data)/, '<span class="pr-highlight">$1</span>');

  return html;
}
---

<BaseLayout title={title} description={description}>
  <Fragment slot="json-ld">
    <JsonLd schema={webPageSchema({ path: '/pricing', title, description })} />
    <JsonLd
      schema={breadcrumbListSchema([
        { name: 'DeltaGlider', path: '/' },
        { name: 'Pricing', path: '/pricing' },
      ])}
    />
    <JsonLd schema={pricingProductSchema(schemaTiers)} />
  </Fragment>

    <section class="calculator-hero shell">
      <div class="calculator-hero-inner measure-wide">
        <h2>What does DeltaGlider save you?</h2>
        <p>
          Type the numbers from your current AWS S3 bill and get an answer in 30
          seconds, even when the answer is no. We don't ask for your email.
        </p>
      </div>
    </section>

    <section class="calculator-section shell">
      <div class="calculator-container">
        <PricingCalculator client:load />
      </div>
    </section>

  <div class="shell">
    <section class="tiers">
      <h2>What you'd pay</h2>

      <h3>Free & evaluation</h3>
      <div class="pricing-stack">
        {
          freeTiers.map((b) => {
            return (
              <div class="pricing-row">
                <div class="pr-tier">
                  <h4 class="tier-title">{b.name}</h4>
                </div>
                <div class="pr-price">
                  <span class="price-val">{b.priceLabel}</span>
                </div>
                <div class="pr-desc" set:html={renderDescription(b.id, b.description)} />
              </div>
            );
          })
        }
      </div>

      <h3 class="tiers-commercial-header">Commercial</h3>
      <div class="pricing-stack">
        {
          commercialTiers.map((b) => {
            return (
              <div class="pricing-row pricing-row-commercial">
                <div class="pr-tier">
                  <h4 class="tier-title">{b.name}</h4>
                </div>
                <div class="pr-price">
                  <span class="price-val">{b.priceLabel}</span>
                </div>
                <div class="pr-desc" set:html={renderDescription(b.id, b.description)} />
              </div>
            );
          })
        }
      </div>

      <h3>OEM & embedding</h3>
      <div class="pricing-stack">
        {
          customTiers.map((b) => {
            return (
              <div class="pricing-row">
                <div class="pr-tier">
                  <h4 class="tier-title">{b.name}</h4>
                </div>
                <div class="pr-price">
                  <span class="price-val">{b.priceLabel}</span>
                </div>
                <div class="pr-desc" set:html={renderDescription(b.id, b.description)} />
              </div>
            );
          })
        }
      </div>
    </section>

    <section class="meter">
      <h2>What we mean by "compressed stored footprint"</h2>

      <p>
        The compressed stored footprint is the number of bytes your
        backend physically stores across all DeltaGlider-managed buckets,
        after DeltaGlider's compression. This is the number we count
        against the license grant, and the one DeltaGlider already shows
        you in the admin dashboard and at <code>/_/stats</code>. Your
        source (logical) bytes, ingress, and egress don't count, and
        neither do storage-layer replicas (whatever your backend does
        under the hood).
      </p>

      <p>
        We don't collect telemetry and the software never phones home.
        Your own dashboard tells you which side of the {FREE_GRANT_TB} TB
        line you are on. You self-report, and we cross-check against the
        <code>/_/stats</code> endpoint only if you give us read access
        during the conversation.
      </p>
    </section>

    <section class="commercial">
      <h2>When do you need the Commercial plan?</h2>

      <p>
        DeltaGlider is source-available under the
        <a href="https://github.com/beshu-tech/deltaglider_proxy/blob/main/LICENSE">Business Source License 1.1</a>.
        The license grants free production use to most deployments,
        and every release becomes Apache-2.0 open source two years after
        it ships. You need a paid license only if one of these applies:
      </p>

      <ul>
        <li>
          Your total compressed stored footprint exceeds
          {FREE_GRANT_TB} TB per organization. This is the Commercial
          plan, at the flat published price above.
        </li>
        <li>
          You offer DeltaGlider itself to your customers as a hosted or
          managed service. That needs an OEM license.
        </li>
        <li>
          The same applies when you embed DeltaGlider in a proprietary
          product you distribute.
        </li>
      </ul>

      <p>
        Everything else is free: internal infrastructure under the grant,
        development, testing, evaluation at any size. If your compressed
        footprint is above {FREE_GRANT_TB} TB, DeltaGlider saves you
        far more than the plan costs. That is exactly what the
        calculator above shows.
      </p>

      <p>
        <a href="mailto:sales@beshu.tech?subject=DeltaGlider%20-%20OEM%20license%20inquiry">
          Talk to sales about OEM
        </a>
      </p>
    </section>

    <section class="faq">
      <div class="faq-header">
        <h2>Frequently asked</h2>
      </div>

      <div class="faq-grid">
        <div class="faq-item">
          <h3>Is DeltaGlider still open source?</h3>
          <p>
            DeltaGlider is source-available. You can read and build every
            line of the public source, and there are no license keys. The
            license doesn't meet the OSI definition of open source. Every
            release automatically becomes Apache-2.0, an open source
            license, two years after it ships. Releases up to v1.17.0
            were GPL-3.0 and stay GPL-3.0 forever.
          </p>
        </div>

        <div class="faq-item">
          <h3>Why one flat price instead of brackets?</h3>
          <p>
            Support effort doesn't scale with your bytes, and charging
            more the better the compression works taxed the product for
            doing its job. Above the free grant, every deployment
            gets the same plan, with the license, support, and signed
            builds all included. If your savings are $200k/yr, good: the
            price stays $5k.
          </p>
        </div>

        <div class="faq-item">
          <h3>Why is the plan $5k? That feels high for "support."</h3>
          <p>
            Support is only part of what you pay for. The $5k buys the
            license above the {FREE_GRANT_TB} TB grant, an SLA on critical
            infrastructure, and a direct email line to the engineers who
            wrote the proxy. Above the grant your compressed footprint
            implies hundreds of terabytes of source data, and the
            calculator above typically shows savings 10 to 40 times the
            plan price.
          </p>
        </div>

        <div class="faq-item">
          <h3>What happens if I cross the {FREE_GRANT_TB} TB line mid-year?</h3>
          <p>
            Nothing breaks and no feature switches off. The software keeps
            working, and the admin dashboard shows your footprint, so you
            can see when you cross the line. At that point you buy the
            Commercial plan. The proxy doesn't phone home, and we send no
            surprise invoices.
          </p>
        </div>

        <div class="faq-item">
          <h3>Replication doubles my footprint. Do you count it twice?</h3>
          <p>
            No. We count the logical compressed bytes that DeltaGlider
            manages. Storage-layer replicas don't count.
          </p>
        </div>

        <div class="faq-item">
          <h3>I'm under the grant. Do I still get the trial?</h3>
          <p>
            Yes. The 30-day trial gives you the Commercial plan's support
            regardless of your size, so you can try it before you need
            it. See <a href="/trial">/trial</a>.
          </p>
        </div>

        <div class="faq-item">
          <h3>How do I get a real compression number on my own data?</h3>
          <p>
            Run
            <code>docker run --rm -it -p 9000:9000 -v dgp-data:/data -e DGP_AUTHENTICATION=none beshultd/deltaglider_proxy</code>,
            copy a sample of your data in, and read the Delta Efficiency
            Panel at <code>/_/admin/diagnostics/delta-efficiency</code>.
            No data leaves your network. Or talk to us and we'll help you
            set it up.
          </p>
        </div>

        <div class="faq-item">
          <h3>What does it cost in speed?</h3>
          <p>
            The compute tax lands on writes, once: delta encoding makes a
            single-stream upload roughly twelve times slower, on the CI
            path, where nobody waits on it. Reads pay about 30% on time
            to first byte when cold and nothing when warm. Encryption is
            effectively free. The measured numbers and the methodology
            are in
            <a href="/docs/explanation/the-compute-tax">the compute tax</a>.
          </p>
        </div>

        <div class="faq-item">
          <h3>What stops me from just using the free grant forever?</h3>
          <p>
            Nothing, if you stay under it. The grant exists so that small
            teams, homelabs, and startups never pay. Above it, the license
            text itself requires a commercial license. The software doesn't
            enforce that, so whether you honor it is a question for your
            compliance process.
          </p>
        </div>
      </div>
    </section>

    <section class="cta">
      <h2>Get started</h2>

      <div class="hero-ctas">
        <a href="/trial" class="btn btn-primary">Start a 30-day trial</a>
        <a href="/docs/tutorials/first-delta-savings" class="btn">Run it free</a>
        <a
          href="mailto:sales@beshu.tech?subject=DeltaGlider%20-%20Sales%20inquiry"
          class="btn"
        >
          Talk to sales
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .tiers,
  .meter,
  .commercial,
  .faq,
  .cta {
    margin: 3rem 0;
  }

  /* === FAQ Redesign === */
  .faq-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .faq-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3.5rem 3rem;
    }
  }

  .faq-item {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ink-strong);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .faq-item p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .faq-item a {
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--brand-line-soft);
    transition: text-decoration-color 0.2s ease;
  }

  .faq-item a:hover {
    text-decoration-color: var(--brand);
  }

  .faq-item code {
    background: var(--surface-tint-strong);
    padding: 0.15rem 0.3rem;
    border-radius: 4px;
    font-size: 0.85em;
    color: var(--ink);
  }

  /* === Calculator Section === */
  .calculator-hero {
    padding: 6rem 0 8rem; /* Extra padding at bottom for the overlapping calculator */
    text-align: center;
    background: radial-gradient(circle at 50% -20%, var(--brand-wash), transparent 60%),
                var(--bg);
    border-bottom: 1px solid var(--rule); /* Establish a solid "hero line" */
  }

  .calculator-hero-inner {
    margin: 0 auto;
  }

  /* The global p rule caps width at the measure and anchors left; this
     hero is centered, so the paragraph must center too. */
  .calculator-hero-inner p {
    margin-inline: auto;
  }

  .calculator-hero h2 {
    font-size: 3rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
    color: var(--ink-strong);
  }

  .calculator-hero p {
    font-size: 1.15rem;
    color: var(--ink-soft);
  }

  .calculator-section {
    padding-bottom: 4rem;
  }

  .calculator-container {
    margin: -5rem auto 0; /* Pull up over the hero section */
    max-width: 1040px; /* Make it significantly wider than measure-wide */
    position: relative;
    z-index: 10;
  }

  /* === Tiers Layout === */
  .tiers h3 {
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-size: 1.15rem;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.5rem;
  }
  
  .tiers h3.tiers-commercial-header {
    color: var(--brand);
    border-bottom-color: var(--brand-soft);
  }

  .tier-title {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--ink-strong);
    letter-spacing: -0.01em;
  }

  /* === Pricing Stack Redesign === */
  .pricing-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }

  .pricing-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    background: var(--bg-card);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease, border-color 0.2s ease;
  }

  @media (min-width: 768px) {
    .pricing-row {
      grid-template-columns: 2fr 1.5fr 4fr;
      align-items: center;
      gap: 2rem;
      padding: 1.75rem 2rem;
    }
  }

  .pricing-row:hover {
    transform: translateY(-2px) scale(1.01);
    box-shadow: var(--shadow-md);
    border-color: var(--rule-strong);
  }

  .pr-price .price-val {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--brand);
    font-family: var(--font-mono);
  }

  .pr-desc {
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.55;
    margin: 0;
  }

  .pr-desc :global(.pr-highlight) {
    color: var(--ink-strong);
    font-weight: 600;
  }

  /* The single Commercial row gets the brand accent the pillar grid used to carry. */
  .pricing-row-commercial {
    border-top: 4px solid var(--brand);
  }
</style>
