---
// /saas — v5 plan §4.2.
// Cost-driven migration story for SaaS / platform teams.
// Calculator CTA front-and-center; per-version compression table
// (verified, publishable today); migration playbook.

import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import ScaleChart from '../components/ScaleChart.astro';
import MechanismExplanation from '../components/MechanismExplanation.astro';
import CompressionResultsTable from '../components/CompressionResultsTable.astro';
import { webPageSchema, breadcrumbListSchema } from '../lib/seo';

const title = 'DeltaGlider for SaaS: cut S3 storage cost on versioned artifacts';
const description =
  'An S3 proxy that stores similar builds as small binary diffs instead of full copies. Your clients keep the same S3 API. It is source-available and free up to 15 TB.';
---

<BaseLayout title={title} description={description}>
  <Fragment slot="json-ld">
    <JsonLd schema={webPageSchema({ path: '/saas', title, description })} />
    <JsonLd
      schema={breadcrumbListSchema([
        { name: 'DeltaGlider', path: '/' },
        { name: 'For SaaS', path: '/saas' },
      ])}
    />
  </Fragment>
  <section class="saas-hero">
    <div class="shell hero-grid">
      <div class="hero-content">
        <h1>Cut the S3 bill for your build artifacts.</h1>

        <p class="hero-lede">
          DeltaGlider is an S3 proxy that spots similar files and stores
          them as small binary diffs instead of full copies. Each build
          your CI ships shares most of its bytes with the previous one, so
          DeltaGlider stores the difference and rebuilds the rest on read.
          The S3 API is the same and your SDKs don't change.
        </p>

        <div class="hero-ctas">
          <a href="/pricing#calculator" class="btn btn-primary">Calculate your savings</a>
          <a href="/trial" class="btn">30-day trial</a>
          <a href="/docs/tutorials/first-delta-savings" class="btn">docker run</a>
        </div>
      </div>
      
      <div class="hero-visual">
        <ScaleChart compact />
      </div>
    </div>
  </section>

  <div class="shell">
    <MechanismExplanation />

    <section class="compute-tax">
      <h2>What it costs in speed</h2>

      <p>
        We measured these numbers by running the repo's own benchmark
        harness on the same artifacts in four modes, in one Hetzner
        region, over a single stream:
      </p>

      <div class="tax-scroll">
      <table>
        <thead>
          <tr><th>Mode</th><th>PUT</th><th>Cold GET</th><th>Warm GET</th></tr>
        </thead>
        <tbody>
          <tr><td>Passthrough (baseline)</td><td>106 MB/s</td><td>97 MB/s</td><td>90 MB/s</td></tr>
          <tr><td>Encryption only</td><td>94 MB/s</td><td>no slowdown</td><td>no slowdown</td></tr>
          <tr><td>Delta compression</td><td>9 MB/s</td><td>89 MB/s</td><td>no slowdown</td></tr>
          <tr><td>Compression + encryption</td><td>9 MB/s</td><td>85 MB/s</td><td>no slowdown</td></tr>
        </tbody>
      </table>
      </div>

      <p>
        The tax lands on the write path, once, where CI is the one
        waiting: the xdelta3 encode makes a single-stream upload about
        twelve times slower. Reads are the path a person feels. They
        pay about 30% on time to first byte when the reference is cold
        and nothing when it is warm. Encryption is effectively free.
      </p>

      <p class="case-study-link">
        <a href="/docs/explanation/the-compute-tax">The full numbers and methodology</a>
      </p>
    </section>

    <section class="in-progress">
      <div class="in-progress-grid">
        <div class="narrative-col">
          <span class="section-eyebrow">Dogfooding</span>
          <h2>ReadonlyREST's build catalog now lives on Hetzner</h2>

          <p>
            Beshu Tech migrated its own ReadonlyREST build catalog,
            1.71 TB on AWS S3, to Hetzner through DeltaGlider. The
            catalog now takes 134 GB, roughly 1,270% smaller, and serves
            production downloads today.
          </p>
          <p class="case-study-link"><a href="/case-studies/readonlyrest-builds">Read the full case study</a></p>
        </div>

        <div class="data-col results-card">
          <h3 class="card-title">Verified results</h3>
          <CompressionResultsTable detailed={false} />
        </div>
      </div>
    </section>


    <section class="playbook">
      <h2>What a migration looks like</h2>

      <div class="playbook-grid">
        <div class="playbook-step">
          <div class="step-number">01</div>
          <h3>Deploy</h3>
          <p>
            Run DeltaGlider in your VPC. Point it at your existing AWS
            bucket, or at a new Hetzner, Backblaze, or Cloudflare bucket.
            Anything S3-compatible works.
          </p>
        </div>
        
        <div class="playbook-step">
          <div class="step-number">02</div>
          <h3>Scan</h3>
          <p>
            Use the Delta Efficiency Panel to scan a sample prefix and
            check that the compression is in the range that justifies the
            migration.
          </p>
        </div>

        <div class="playbook-step">
          <div class="step-number">03</div>
          <h3>Stage</h3>
          <p>
            Stage the migration one bucket at a time with per-bucket
            aliases. Freeze writes during the window with
            <code>quota_bytes: 0</code>.
          </p>
        </div>

        <div class="playbook-step">
          <div class="step-number">04</div>
          <h3>Cutover</h3>
          <p>
            Cut over your apps' S3 endpoint to DeltaGlider. The SDKs
            stay as they are.
          </p>
        </div>

        <div class="playbook-step">
          <div class="step-number">05</div>
          <h3>Replicate</h3>
          <p>
            If you need a DR region, run replication rules to mirror new
            writes to it.
          </p>
        </div>
      </div>

      <div class="playbook-footer">
        <p>
          The Commercial plan's support helps with each of these steps.
          See <a href="/trial">/trial</a> for the 30-day trial.
        </p>
      </div>
    </section>

    <section class="cta">
      <h2>Next step</h2>
      <div class="hero-ctas">
        <a href="/pricing#calculator" class="btn btn-primary">Try the savings calculator</a>
        <a href="/trial" class="btn">Start a 30-day trial</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Four columns do not fit a phone: scroll the table, not the page. */
  .tax-scroll { overflow-x: auto; }

  /* === Hero Section === */
  .saas-hero {
    padding: 6rem 0 4rem;
    background: radial-gradient(circle at 80% -20%, var(--brand-tint), transparent 50%),
                var(--bg);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .saas-hero h1 {
    font-size: var(--fs-display);
    line-height: 1.05;
    margin-bottom: 1.5rem;
    letter-spacing: -0.03em;
  }

  .hero-visual { min-width: 0; }

  /* === Rhythm & Layouts === */
  .in-progress,
  .playbook,
  .cta {
    margin: 6rem 0;
  }

  /* === In Progress Grid === */
  .in-progress-grid {
    display: grid;
    /* minmax(0, …) so the results table scrolls inside its card
       instead of widening the page on phones. */
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .in-progress-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: center;
    }
  }

  .results-card {
    background: var(--bg-card);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    padding: 1.5rem;
  }
  .results-card :global(.table-scroll) { margin-bottom: 0; }
  .results-card :global(.compact-table) { min-width: 0; }

  .card-title {
    font-size: var(--fs-h3);
    color: var(--ink-strong);
    margin: 0 0 1rem;
  }

  .case-study-link {
    margin-top: 2rem;
    font-weight: 600;
  }

  /* === Playbook Grid === */
  /* The playbook is a real sequence: one numbered step per row. */
  .playbook-grid {
    display: grid;
    gap: 0;
    margin: 2rem 0 2.5rem;
    max-width: 46rem;
  }

  .playbook-step {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    column-gap: 1rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--rule);
  }
  .playbook-step:last-child { border-bottom: 1px solid var(--rule); }

  .step-number {
    grid-row: span 2;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--brand);
    line-height: 1.6;
  }

  .playbook-step h3 {
    font-size: var(--fs-h3);
    margin: 0 0 0.35rem;
    color: var(--ink-strong);
  }

  .playbook-step p {
    color: var(--ink-soft);
    margin: 0;
  }

  .playbook-footer {
    max-width: var(--measure);
    color: var(--ink-soft);
  }

  /* Phones: 8rem section gaps, 2rem card padding and a 3rem heading
     margin inside each step left more air than text. */
  @media (max-width: 599px) {
    .in-progress,
    .playbook,
    .cta {
      margin: 4.5rem 0;
    }
    .results-card {
      padding: 1.25rem;
    }
    .playbook-step { grid-template-columns: 2.25rem minmax(0, 1fr); }
    .playbook-step p {
      font-size: 1rem;
    }
  }
</style>
