---
// /docs — the documentation landing. Groups + ordering come from the shared
// manifest, so it mirrors the in-product docs landing exactly.
import DocsLayout from '../../layouts/DocsLayout.astro';
import Glyph from '../../components/Glyph.astro';
import { docsByGroup } from '../../lib/docs';

const groups = docsByGroup();

// Group id → pictogram (see Glyph.astro for the set).
const GROUP_GLYPHS: Record<string, any> = {
  'Start here': 'flag',
  'Guides: deploy & operate': 'wrench',
  'Guides: storage & data': 'replicate',
  'Guides: access & security': 'shield-key',
  'Reference': 'book',
  'Concepts': 'bulb',
};
---

<DocsLayout
  title="Documentation — DeltaGlider Proxy"
  description="DeltaGlider Proxy documentation: tutorials, how-to guides, reference, and concepts. These are the same docs that ship inside the product."
  activeSlug=""
>
  <header class="docs-landing-head">
    <h1>DeltaGlider Proxy documentation</h1>
    <p class="docs-landing-lede">
      DeltaGlider is an S3 proxy that sits between your applications and
      S3-compatible storage. It stores similar files as small binary diffs
      of each other instead of full copies, and you don't need to change
      your client code. The proxy is source-available (BUSL-1.1) and free
      up to 15 TB.
    </p>
    <p class="docs-landing-sub">
      Press <kbd>⌘K</kbd> to search.
    </p>

    <p class="docs-landing-start-label">Recommended starting points</p>
    <div class="docs-landing-start">
      <a class="docs-start-card" href="/docs/tutorials/first-delta-savings">
        <span class="docs-start-eyebrow">Start here</span>
        <span class="docs-start-title">See your first delta <span class="docs-start-nowrap">savings</span></span>
        <span class="docs-start-note">Go from zero to a working proxy with measurable compression.</span>
      </a>
      <a class="docs-start-card" href="/docs/explanation/delta-compression">
        <span class="docs-start-eyebrow">Understand it</span>
        <span class="docs-start-title">How delta compression <span class="docs-start-nowrap">works</span></span>
        <span class="docs-start-note">Which files compress, which don't, and why.</span>
      </a>
      <a class="docs-start-card" href="/docs/reference/configuration">
        <span class="docs-start-eyebrow">Reference</span>
        <span class="docs-start-title">Configuration <span class="docs-start-nowrap">reference</span></span>
        <span class="docs-start-note">Every config field, with its type, default, and hot-reload behavior.</span>
      </a>
    </div>

  </header>

  {groups.map((g) => (
    <section class="docs-landing-group">
      <h2 class="docs-landing-group-title">
        <Glyph name={GROUP_GLYPHS[g.group.id] ?? 'book'} size={30} />
        <span>{g.group.id}</span>
      </h2>
      <p class="docs-landing-tagline">{g.group.tagline}</p>
      <ul class="docs-landing-list">
        {g.docs.filter((d) => d.slug !== '').map((d) => (
          <li>
            <a href={d.url}>
              <span class="docs-landing-list-title">{d.title}</span>
              {d.summary && <span class="docs-landing-list-note">{d.summary}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</DocsLayout>
