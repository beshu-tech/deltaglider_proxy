---
// Homepage — rewritten 2026-06. Structure: one problem-first hero, then
// each section answers exactly one question, in the order a skeptical
// engineer asks them:
//   hero         what is it, why do I care
//   Scale        the claim drawn to scale + the ZIP objection (same artifact)
//   DropIn       what adoption costs (one config line) + trust facts
//   ControlPlane the other half of the product + real admin-UI screens
//   DueDiligence the visitor's own questions, answered with links
//   Fit          is it for MY workload (honest no's) + where to go next
//   Quickstart   let me touch it
// No section repeats another's job. Casualties of the rethink: the stats
// band, the abstract flow diagram, the standalone gallery, the doors grid,
// and the alternatives comparison table — each either re-told a neighbour's
// story or duplicated the nav.

import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import TestimonialsBlock from '../components/TestimonialsBlock.astro';
import WorkloadFitTable from '../components/WorkloadFitTable.astro';
import HeroDiagram from '../components/HeroDiagram.astro';
import DemoVideo from '../components/DemoVideo.astro';
import StorageScale from '../components/StorageScale.astro';
import DropIn from '../components/DropIn.astro';
import ControlPlane from '../components/ControlPlane.astro';
import {
  organizationSchema,
  webSiteSchema,
  softwareApplicationSchema,
} from '../lib/seo';
---

<BaseLayout
  title="DeltaGlider Proxy — the object storage control plane"
  description="An S3 proxy that spots similar files and stores them as small binary diffs instead of full copies. The S3 API stays the same and clients don't change. It adds IAM, SSO, replication, and encryption on any S3-compatible backend. Source-available and free up to 15 TB."
>
  <Fragment slot="json-ld">
    <JsonLd schema={organizationSchema()} />
    <JsonLd schema={webSiteSchema()} />
    <JsonLd schema={softwareApplicationSchema()} />
  </Fragment>

  {/* ============================== HERO ============================== */}
  {/* Copy on the left, the control-plane diagram on the right. Below
      900 px the diagram stacks under the copy, so phones get it too. */}
  <section class="hero">
    <div class="shell hero-grid hero-grid--home">
      <div class="hero-copy">
        <span class="hero-eyebrow">
          <span class="hero-eyebrow-dot"></span>
          Written in Rust · Kubernetes-ready · free up to 15 TB
        </span>

        <h1>The object storage control&nbsp;plane</h1>

        <p class="hero-lede">
          An S3 proxy in front of your bucket, with the same API and no
          changes to your clients:
        </p>

        <ul class="hero-points">
          <li>Similar files are stored as small binary diffs instead of full copies.</li>
          <li>The proxy applies AES-256 before the bytes reach the bucket, and the key never leaves you.</li>
          <li>You get the same S3 API on AWS, Hetzner, Wasabi, or MinIO, with cross-cloud replication.</li>
          <li>Per-user IAM, SSO, and audit logs work on any backend.</li>
        </ul>

        <div class="hero-ctas">
          <a href="/trial" class="btn btn-brand">Start free trial</a>
          <a href="#demo-video" class="btn">90s&nbsp;video</a>
          <a href="https://github.com/beshu-tech/deltaglider_proxy" class="btn btn-ghost">GitHub</a>
        </div>

        <p class="hero-trust">
          Built by Beshu Tech (the
          <a href="https://readonlyrest.com">ReadonlyREST</a> team), which
          <a href="/case-studies/readonlyrest-builds">serves its own
          1.71&nbsp;TB build catalog through the proxy in production</a>.
          Our engineers write it with Claude as a coding aid, and we say
          so in the
          <a href="https://github.com/beshu-tech/deltaglider_proxy/commits/main">commit trailers</a>.
        </p>
      </div>
      <HeroDiagram />
    </div>
  </section>

  {/* ======================= SEE IT IN ACTION ======================== */}
  <DemoVideo />

  {/* ===================== THE CLAIM, DRAWN TO SCALE ================== */}
  <StorageScale />

  {/* ============================ DROP-IN ============================= */}
  <DropIn />

  {/* ======================= THE OTHER HALF =========================== */}
  <ControlPlane />

  {/* ====================== DUE DILIGENCE ============================= */}
  <section class="section section-alt">
    <div class="shell">
      <h2>The questions you'd ask anyway</h2>

      <p>
        Each answer links to something you can check yourself.
      </p>

      <div class="dd-grid">
        <article class="dd-card">
          <h3 class="dd-q">Will it corrupt my artifacts?</h3>
          <p class="dd-a">
            Every delta read is rebuilt and checked with SHA-256 against
            the hash recorded at upload. More than 2,000 unit tests and an
            integration matrix against a real MinIO must pass before every
            merge.
          </p>
          <a class="dd-link" href="https://github.com/beshu-tech/deltaglider_proxy">Read the source: every line is public</a>
        </article>

        <article class="dd-card">
          <h3 class="dd-q">What breaks in production?</h3>
          <p class="dd-a">
            We pushed our own 1.71&nbsp;TB release catalog through the
            proxy. Upstream TMPDIR, proxy timeouts, and EBS exhaustion
            broke along the way, and we published every bug with its fix.
          </p>
          <a class="dd-link" href="/case-studies/readonlyrest-builds">Read the migration log</a>
        </article>

        <article class="dd-card">
          <h3 class="dd-q">Will bugs get fixed, or hidden?</h3>
          <p class="dd-a">
            A correctness audit by five investigators found 10 bugs. We
            fixed all of them, pinned each one with a regression test, and
            wrote them up bug by bug where you can read them.
          </p>
          <a class="dd-link" href="https://github.com/beshu-tech/deltaglider_proxy/blob/main/CHANGELOG.md">The bug-by-bug CHANGELOG</a>
        </article>

        <article class="dd-card">
          <h3 class="dd-q">Who answers when it breaks at 2 a.m.?</h3>
          <p class="dd-a">
            The people whose names are in <code>git log</code>. Your mail
            goes directly to the engineers who wrote the code.
          </p>
          <a class="dd-link" href="mailto:contact@beshu.tech?subject=DeltaGlider%20-%20General%20inquiry">contact@beshu.tech</a>
        </article>

        <article class="dd-card dd-card--wide">
          <h3 class="dd-q">Who wrote it, engineers or an AI?</h3>
          <p class="dd-a">
            The engineers in <code>git log</code>, with help from Claude
            (Opus 5.5 in the latest commits); most of the commits are by
            Simone Scarduzio, the founder of Beshu Tech. Nearly nine in ten commits on
            <code>main</code> carry a <code>Co-Authored-By: Claude</code>
            trailer that names the model used for that commit, starting
            with the first release in December 2025. The engineers make
            the commits and answer for them; the model works from
            <code>CLAUDE.md</code>, a public file in the repo with the
            architecture rules and the design decisions it may not change
            (shelling out to the xdelta3 CLI is one). Every commit, with
            or without Claude, goes through the same gate: more than 2,000
            unit tests, the MinIO integration matrix, clippy with warnings
            as errors, a RustSec audit, and cargo-deny.
          </p>
          <a class="dd-link" href="https://github.com/beshu-tech/deltaglider_proxy/blob/main/CLAUDE.md">Read the instructions we give the model: CLAUDE.md</a>
        </article>
      </div>

      <TestimonialsBlock />
    </div>
  </section>

  {/* ============================ HONEST FIT ========================== */}
  <section class="section">
    <div class="shell">
      <WorkloadFitTable />

      <p class="fit-next">
        Then put your real numbers into the
        <a href="/pricing">savings calculator</a>. There is more detail
        <a href="/saas">for CI &amp; build artifacts</a> and
        <a href="/regulated">for regulated buyers</a>.
      </p>
    </div>
  </section>

  {/* ============================ QUICKSTART ========================== */}
  <section class="section section-alt">
    <div class="shell">
      <h2>Touch it in 60 seconds</h2>

      <div class="term">
        <div class="term-bar" aria-hidden="true">
          <span class="term-title">shell</span>
        </div>
        <pre class="term-pre"><code><span class="term-prompt">$</span> docker run --rm -it -p 9000:9000 -v dgp-data:/data \
    -e DGP_AUTHENTICATION=none \
    beshultd/deltaglider_proxy</code></pre>
      </div>

      <p>
        Open <code>http://localhost:9000/_/</code> for the browser, or
        point any S3 SDK at <code>http://localhost:9000</code>. Open
        access is meant for a first look on localhost;
        <a href="/docs/tutorials/secure-your-proxy">the second tutorial
        locks it down</a>.
      </p>

      <div class="hero-ctas">
        <a href="/docs/tutorials/first-delta-savings" class="btn btn-brand">Full tutorial</a>
        <a href="/trial" class="btn">30-day support trial</a>
        <a href="https://github.com/beshu-tech/deltaglider_proxy" class="btn btn-ghost">GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-points {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
    max-width: 33rem;
  }

  .hero-points li {
    margin: 0;
    max-width: none;
    color: var(--ink-soft);
    font-size: 1.02rem;
    line-height: 1.55;
    padding-left: 1.1rem;
    position: relative;
  }

  .hero-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand);
  }

  .hero-points strong {
    color: var(--ink-strong);
  }

  .dd-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin: 2.5rem 0 3.5rem;
  }

  @media (min-width: 760px) {
    .dd-grid { grid-template-columns: 1fr 1fr; }
  }

  .dd-card {
    position: relative;
    overflow: hidden;
    padding: 1.75rem 2rem;
    background: var(--bg-card);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
  }


  /* the provenance card spans both columns; give its text more room */
  .dd-card--wide { grid-column: 1 / -1; }
  .dd-card--wide .dd-q { max-width: 30ch; }
  .dd-card--wide .dd-a { max-width: var(--measure); }

  .dd-q {
    margin: 0 0 0.8rem;
    font-size: var(--fs-h3);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--ink-strong);
    max-width: 18ch;
  }

  .dd-a {
    margin: 0 0 1.1rem;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 48ch;
  }

  .dd-link {
    font-weight: 600;
    color: var(--brand-dark);
    text-decoration: none;
  }
  .dd-link:hover { text-decoration: underline; }

  .fit-next {
    margin-top: 1.5rem;
    color: var(--ink-soft);
  }

  /* quickstart terminal window */
  .term {
    max-width: var(--measure-wide);
    border: 1px solid var(--rule-strong);
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--panel-dark-bg);
    margin: 1.75rem 0;
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .term-title {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--panel-dark-ink-dim);
  }

  .term-pre {
    margin: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    padding: 1.4rem 1.5rem 1.5rem;
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .term-pre code {
    color: var(--panel-dark-ink);
    background: transparent;
  }

  .term-prompt { color: var(--panel-dark-accent); font-weight: 700; }

  /* Phones: 2.4rem card padding left a 270 px text column; the links get
     44 px rows. */
  @media (max-width: 599px) {
    .dd-card { padding: 1.5rem 1.25rem 1.25rem; }
    .dd-card::before { font-size: 5.5rem; top: -1.1rem; }
    .dd-q { font-size: 1.3rem; max-width: none; padding-right: 3.5rem; }
    .dd-link { display: inline-block; padding: 0.6rem 0; }
    .term-pre { padding: 1.1rem 1rem 1.2rem; font-size: 0.9rem; }
  }
</style>
