---
// Homepage — rewritten 2026-06. Structure: one problem-first hero, then
// each section answers exactly one question, in the order a skeptical
// engineer asks them:
//   hero         what is it, why do I care
//   Scale        the claim drawn to scale + the ZIP objection (same artifact)
//   DropIn       what adoption costs (one config line) + trust facts
//   ControlPlane the other half of the product + real admin-UI screens
//   DueDiligence the visitor's own questions, answered with links
//   Fit          is it for MY workload (honest no's)
//   Cost         what compression costs, measured
//   Price        what you pay
// The quickstart command lives in the hero (2026-11, docs/plan/site-rewrite-2026-11.md).
// No section repeats another's job. Casualties of the rethink: the stats
// band, the abstract flow diagram, the standalone gallery, the doors grid,
// and the alternatives comparison table — each either re-told a neighbour's
// story or duplicated the nav.

import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import QuickstartTerminal from '../components/QuickstartTerminal.astro';
import WorkloadFitTable from '../components/WorkloadFitTable.astro';
import HeroDiagram from '../components/HeroDiagram.astro';
import DemoVideo from '../components/DemoVideo.astro';
import StorageScale from '../components/StorageScale.astro';
import DropIn from '../components/DropIn.astro';
import ControlPlane from '../components/ControlPlane.astro';
import {
  organizationSchema,
  webSiteSchema,
  softwareApplicationSchema,
} from '../lib/seo';
---

<BaseLayout
  title="DeltaGlider — an S3 proxy that stores versioned binaries in 60–95% less space"
  description="An S3 proxy that spots similar files and stores them as small binary diffs instead of full copies. The S3 API stays the same and clients don't change. It adds IAM, SSO, and replication on any S3-compatible backend, and encryption on every backend with atomic writes. Source-available and free up to 15 TB."
>
  <Fragment slot="json-ld">
    <JsonLd schema={organizationSchema()} />
    <JsonLd schema={webSiteSchema()} />
    <JsonLd schema={softwareApplicationSchema()} />
  </Fragment>

  {/* ============================== HERO ============================== */}
  {/* Copy on the left, the control-plane diagram on the right. Below
      900 px the diagram stacks under the copy, so phones get it too. */}
  <section class="hero">
    <div class="shell hero-grid hero-grid--home">
      <div class="hero-copy">
        <span class="hero-eyebrow">
          <span class="hero-eyebrow-dot"></span>
          Free up to 15 TB · one binary · written in Rust
        </span>

        <h1>Store every build, backup and release in 60–95% less&nbsp;space</h1>

        <p class="hero-lede">
          DeltaGlider is an S3 proxy in front of the bucket you already
          have. It stores similar files as small binary diffs, and your
          clients keep the same S3 API.
        </p>

        <QuickstartTerminal />

        <p class="hero-after-term">
          Then open <code>http://localhost:9000/_/</code>, or point any S3
          SDK at <code>http://localhost:9000</code>. Open access is for a
          first look on localhost only.
        </p>

        <div class="hero-ctas">
          <a href="/docs/tutorials/first-delta-savings" class="btn btn-brand">Follow the tutorial</a>
          <a href="/pricing#calculator" class="btn">Estimate your savings</a>
          <a href="https://github.com/beshu-tech/deltaglider_proxy" class="btn btn-ghost">GitHub</a>
        </div>

        <p class="hero-also">
          The same binary encrypts objects with AES-256 before they reach
          the bucket, gives each user SSO and their own S3 permissions,
          keeps an audit log, and replicates between AWS, Hetzner, Wasabi
          and MinIO.
        </p>

        <p class="hero-trust">
          In production: Beshu Tech (the
          <a href="https://readonlyrest.com">ReadonlyREST</a> team) serves
          its 1.71&nbsp;TB build catalog through the proxy.
          <a href="/case-studies/readonlyrest-builds">Read the migration
          log</a>. For help from the engineers, there is a
          <a href="/support">30-day commercial trial</a>.
        </p>
      </div>
      <HeroDiagram />
    </div>
  </section>

  {/* ===================== THE CLAIM, DRAWN TO SCALE ================== */}
  <StorageScale />

  {/* ============================ HONEST FIT ========================== */}
  <section class="section section-alt">
    <div class="shell">
      <WorkloadFitTable />

      <p class="fit-next">
        Put your own numbers into the
        <a href="/pricing#calculator">savings calculator</a>, or read the
        detail <a href="/build-artifacts">for build artifacts</a>.
      </p>
    </div>
  </section>

  {/* ============================ DROP-IN ============================= */}
  <DropIn />

  {/* ============================ THE COST ============================ */}
  <section class="section section-alt">
    <div class="shell">
      <h2>What it costs</h2>

      <p>
        Compression is not free. We measured these on our own artifacts,
        in one Hetzner region, over a single stream.
      </p>

      <dl class="cost-list">
        <div>
          <dt>Uploads are slower</dt>
          <dd>
            A PUT that is stored as a delta ran at 9&nbsp;MB/s, against
            106&nbsp;MB/s for a file stored whole. The proxy computes the
            diff before it answers.
          </dd>
        </div>
        <div>
          <dt>Downloads are about the same</dt>
          <dd>
            A cold GET of a delta ran at 89&nbsp;MB/s, against
            97&nbsp;MB/s. A warm GET showed no slowdown.
          </dd>
        </div>
        <div>
          <dt>It is one more service to run</dt>
          <dd>
            One binary on one port. A single instance is the supported
            production setup; several instances behind a load balancer
            need the routing that the Kubernetes operator sets up.
          </dd>
        </div>
      </dl>

      <p class="fit-next">
        <a href="/build-artifacts#speed">The full table and the method</a>
        · <a href="/docs/how-to/scale-out-with-the-kubernetes-operator">Running several instances</a>
      </p>
    </div>
  </section>

  {/* ======================= THE OTHER HALF =========================== */}
  <ControlPlane />

  {/* ======================= SEE IT IN ACTION ======================== */}
  <DemoVideo />

  {/* ====================== DUE DILIGENCE ============================= */}
  <section class="section">
    <div class="shell">
      <h2>The questions you'd ask anyway</h2>

      <p>
        Each answer links to something you can check yourself.
      </p>

      <div class="dd-grid">
        <article class="dd-card">
          <h3 class="dd-q">Will it corrupt my artifacts?</h3>
          <p class="dd-a">
            Every delta read is rebuilt and checked with SHA-256 against
            the hash recorded at upload. More than 2,000 unit tests and an
            integration matrix against a real MinIO must pass before every
            merge.
          </p>
          <a class="dd-link" href="https://github.com/beshu-tech/deltaglider_proxy">Read the source: every line is public</a>
        </article>

        <article class="dd-card">
          <h3 class="dd-q">What breaks in production?</h3>
          <p class="dd-a">
            We pushed our own 1.71&nbsp;TB release catalog through the
            proxy. Upstream TMPDIR, proxy timeouts, and EBS exhaustion
            broke along the way, and we published every bug with its fix.
          </p>
          <a class="dd-link" href="/case-studies/readonlyrest-builds">Read the migration log</a>
        </article>

        <article class="dd-card">
          <h3 class="dd-q">Will bugs get fixed, or hidden?</h3>
          <p class="dd-a">
            A correctness audit by five investigators found 10 bugs. We
            fixed all of them, pinned each one with a regression test, and
            wrote them up bug by bug where you can read them.
          </p>
          <a class="dd-link" href="https://github.com/beshu-tech/deltaglider_proxy/blob/main/CHANGELOG.md">The bug-by-bug CHANGELOG</a>
        </article>

        <article class="dd-card">
          <h3 class="dd-q">Who answers when it breaks at 2 a.m.?</h3>
          <p class="dd-a">
            The people whose names are in <code>git log</code>. Your mail
            goes directly to the engineers who wrote the code.
          </p>
          <a class="dd-link" href="mailto:contact@beshu.tech?subject=DeltaGlider%20-%20General%20inquiry">contact@beshu.tech</a>
        </article>

        <article class="dd-card dd-card--wide">
          <h3 class="dd-q">Who wrote it, engineers or an AI?</h3>
          <p class="dd-a">
            The engineers in <code>git log</code>, with help from Claude
            (Opus 5.5 in the latest commits); most of the commits are by
            Simone Scarduzio, the founder of Beshu Tech. Nearly nine in ten commits on
            <code>main</code> carry a <code>Co-Authored-By: Claude</code>
            trailer that names the model used for that commit, starting
            with the first release in December 2025. The engineers make
            the commits and answer for them; the model works from
            <code>CLAUDE.md</code>, a public file in the repo with the
            architecture rules and the design decisions it may not change
            (shelling out to the xdelta3 CLI is one). Every commit, with
            or without Claude, goes through the same gate: more than 2,000
            unit tests, the MinIO integration matrix, clippy with warnings
            as errors, a RustSec audit, and cargo-deny.
          </p>
          <a class="dd-link" href="https://github.com/beshu-tech/deltaglider_proxy/blob/main/CLAUDE.md">Read the instructions we give the model: CLAUDE.md</a>
        </article>
      </div>

    </div>
  </section>

  {/* ============================= PRICE ============================== */}
  <section class="section section-alt">
    <div class="shell">
      <h2>What you pay</h2>

      <p>
        Nothing up to 15&nbsp;TB of stored data per organization, in
        production, with every feature. Above that there is one flat
        annual plan. The licence is BUSL-1.1, and each release becomes
        Apache-2.0 two years after it ships.
      </p>

      <p class="fit-next">
        <a href="/pricing">Prices and the calculator</a> ·
        <a href="/support">30 days of support from the engineers, free</a>
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  /* The headline is a sentence, so it gets a wider measure and a
     smaller size than the display default. */
  .hero h1 {
    max-width: 19ch;
    font-size: clamp(2.1rem, 4.4vw, 3.25rem);
    line-height: 1.08;
  }

  .hero-after-term,
  .hero-also {
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 36rem;
    margin: 0.9rem 0 0;
  }

  .hero-also { margin-top: 1.75rem; }

  .hero .hero-ctas { margin-top: 1.5rem; }
  .hero .hero-trust { max-width: 36rem; margin-top: 1.25rem; }

  .dd-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin: 2.5rem 0 3.5rem;
  }

  @media (min-width: 760px) {
    .dd-grid { grid-template-columns: 1fr 1fr; }
  }

  .dd-card {
    position: relative;
    overflow: hidden;
    padding: 1.75rem 2rem;
    background: var(--bg-card);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
  }


  /* the provenance card spans both columns; give its text more room */
  .dd-card--wide { grid-column: 1 / -1; }
  .dd-card--wide .dd-q { max-width: 30ch; }
  .dd-card--wide .dd-a { max-width: var(--measure); }

  .dd-q {
    margin: 0 0 0.8rem;
    font-size: var(--fs-h3);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--ink-strong);
    max-width: 18ch;
  }

  .dd-a {
    margin: 0 0 1.1rem;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 48ch;
  }

  .dd-link {
    font-weight: 600;
    color: var(--brand-dark);
    text-decoration: none;
  }
  .dd-link:hover { text-decoration: underline; }

  .cost-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem 2.5rem;
    margin: 2rem 0 0;
  }
  @media (min-width: 760px) {
    .cost-list { grid-template-columns: repeat(3, 1fr); }
  }
  .cost-list dt {
    font-weight: 700;
    color: var(--ink-strong);
    margin-bottom: 0.35rem;
  }
  .cost-list dd {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.55;
  }

  .fit-next {
    margin-top: 1.5rem;
    color: var(--ink-soft);
  }

  /* Phones: 2.4rem card padding left a 270 px text column; the links get
     44 px rows. */
  @media (max-width: 599px) {
    .dd-card { padding: 1.5rem 1.25rem 1.25rem; }
    .dd-card::before { font-size: 5.5rem; top: -1.1rem; }
    .dd-q { font-size: 1.3rem; max-width: none; padding-right: 3.5rem; }
    .dd-link { display: inline-block; padding: 0.6rem 0; }
  }
</style>
