---
// BaseLayout.astro — shell every page extends.
// Per the v5 plan §7 visual brief: anti-polish but designed. One brand
// color (teal), one accent, real typography, real chrome.
//
// Inline logo SVG matches the favicon (teal lightning bolt on navy
// rounded square). Brand wordmark uses Manrope (Google Fonts, swap).
// Mono / code blocks use self-hosted JetBrains Mono (OFL).

import '../styles/global.css';
import { SITE } from '../lib/seo';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  canonical,
  ogImage = SITE.ogImage,
  ogType = 'website',
} = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#141a2b" />
    {/* Theme boot — runs before first paint so there is no flash of the
        wrong theme. Stored preference wins; otherwise the OS setting. */}
    <script is:inline>
      (() => {
        let t;
        try { t = localStorage.getItem('dgp-theme'); } catch {}
        if (t !== 'light' && t !== 'dark') {
          t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.theme = t;
        const m = document.querySelector('meta[name="theme-color"]');
        if (m) m.content = t === 'light' ? '#f4f7fb' : '#141a2b';
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Manrope — display sans. Spectral + Hanken Grotesk — hero walkthrough.
        (JetBrains Mono is self-hosted in global.css.) font-display:swap. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Spectral:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;450;500;600;700&display=swap"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="DeltaGlider" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="DeltaGlider — Storage compression for S3, behind the same S3 API." />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="DeltaGlider — Storage compression for S3, behind the same S3 API." />

    <meta name="generator" content={Astro.generator} />

    <slot name="json-ld" />
    {/* Page-scoped head extras (e.g. docs-only display fonts). */}
    <slot name="head" />
  </head>
  <body>
    <SiteHeader />

    <main>
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
