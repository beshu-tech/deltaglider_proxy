---
// BaseLayout.astro — shell every page extends.
// Per the v5 plan §7 visual brief: anti-polish but designed. One brand
// color (teal), one accent, real typography, real chrome.
//
// Inline logo SVG matches the favicon (teal lightning bolt on navy
// rounded square). Brand wordmark uses Manrope (Google Fonts, swap).
// Mono / code blocks use self-hosted JetBrains Mono (OFL).

import '../styles/global.css';
import { SITE } from '../lib/seo';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Wider page shell for the header and footer (the docs layout). */
  wide?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = SITE.ogImage,
  ogType = 'website',
  wide = false,
} = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#141a2b" />
    {/* Theme boot — runs before first paint so there is no flash of the
        wrong theme. Stored preference wins; otherwise the OS setting. */}
    <script is:inline>
      (() => {
        let t;
        try { t = localStorage.getItem('dgp-theme'); } catch {}
        if (t !== 'light' && t !== 'dark') {
          t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.theme = t;
        const m = document.querySelector('meta[name="theme-color"]');
        if (m) m.content = t === 'light' ? '#f4f7fb' : '#141a2b';
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Manrope — the one sans for display and body.
        (JetBrains Mono is self-hosted in global.css.) font-display:swap. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="DeltaGlider" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="DeltaGlider: the object storage control plane, free up to 15 TB." />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="DeltaGlider: the object storage control plane, free up to 15 TB." />

    <meta name="generator" content={Astro.generator} />

    {/* Umami Cloud: cookieless page views + the funnel events below.
        Production builds only, so `astro dev` sends nothing. */}
    {import.meta.env.PROD && (
      <script
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id="9029ecb2-741d-4ac3-b580-7e28da9c6b9e"
        data-domains="deltaglider.com"
      ></script>
    )}
    <script is:inline>
      // Funnel events, one delegated rule for every page. A blocked or
      // absent Umami script makes each of these a no-op.
      (() => {
        const send = (name, data) => {
          try { window.umami && window.umami.track(name, data); } catch (_) {}
        };
        const page = () => location.pathname;
        document.addEventListener('click', (e) => {
          if (!(e.target instanceof Element)) return;
          // The docs copy button uses the clipboard API: no `copy` event.
          if (e.target.closest('.docs-copy-btn')) {
            send('code-copy', { page: page() });
            return;
          }
          const a = e.target.closest('a[href]');
          if (!a) return;
          const href = a.getAttribute('href') || '';
          if (href.startsWith('mailto:')) {
            const subject = decodeURIComponent((href.split('subject=')[1] || '').split('&')[0]);
            send('mailto-click', { page: page(), subject });
          } else if (href.startsWith('https://github.com/beshu-tech/deltaglider_proxy')) {
            send('github-click', { page: page() });
          } else if (href === '/trial') {
            send('trial-click', { page: page() });
          } else if (href.startsWith('/docs/tutorials/')) {
            send('tutorial-click', { page: page(), to: href });
          }
        });
        // Text copied out of a code block (the `docker run` command).
        document.addEventListener('copy', (e) => {
          const el = e.target instanceof Element ? e.target : null;
          if (el && el.closest('pre, code')) send('code-copy', { page: page() });
        });
        // First change of a calculator input, once per page view.
        let calcUsed = false;
        document.addEventListener('input', (e) => {
          if (calcUsed || !(e.target instanceof Element) || !e.target.closest('.calc')) return;
          calcUsed = true;
          send('calculator-use', { page: page() });
        });
      })();
    </script>

    <slot name="json-ld" />
    {/* Page-scoped head extras (e.g. docs-only display fonts). */}
    <slot name="head" />
  </head>
  <body class:list={{ 'shell-wide': wide }}>
    <SiteHeader />

    <main>
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
