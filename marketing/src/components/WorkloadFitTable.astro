---
// WorkloadFitTable.astro
//
// "Will it work on your data?" honesty table from v5 plan §4.1.
// The point is self-disqualification: tell people NOT to use DeltaGlider
// when their data won't compress. That earns trust.
import Glyph from './Glyph.astro';
---

<section class="workload-fit">
  <h2>Will it work on your data?</h2>

  <table>
    <thead>
      <tr>
        <th>Your data looks like</th>
        <th>Expected</th>
        <th>Recommend</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>CI artifacts, build catalogs, plugin marketplaces</td>
        <td>1,000% to 10,000% smaller</td>
        <td><span class="fit fit--yes"><Glyph name="check" bare size={16} tone="ok" /> Yes</span></td>
      </tr>
      <tr>
        <td>DB dumps, daily backups, ML model variants</td>
        <td>500% to 5,000% smaller</td>
        <td><span class="fit fit--yes"><Glyph name="check" bare size={16} tone="ok" /> Yes</span></td>
      </tr>
      <tr>
        <td>Container layers, Maven / PyPI mirrors</td>
        <td>1,000% to 5,000% smaller</td>
        <td><span class="fit fit--yes"><Glyph name="check" bare size={16} tone="ok" /> Yes</span></td>
      </tr>
      <tr>
        <td>Random user uploads, encrypted blobs, raw video</td>
        <td>0% to 100% smaller</td>
        <td><span class="fit fit--no"><Glyph name="cross" bare size={16} tone="neg" /> Use plain S3</span></td>
      </tr>
      <tr>
        <td>Append-only logs, streaming telemetry</td>
        <td>0% smaller</td>
        <td><span class="fit fit--no"><Glyph name="cross" bare size={16} tone="neg" /> Use plain S3</span></td>
      </tr>
    </tbody>
  </table>

</section>

<style>
  .fit { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; }
  .workload-fit { margin: 0; }
  .workload-fit h2 { margin-top: 0; }

  .workload-note {
    color: var(--ink-soft);
    font-style: italic;
    font-size: 0.95rem;
    max-width: var(--measure);
  }
</style>
