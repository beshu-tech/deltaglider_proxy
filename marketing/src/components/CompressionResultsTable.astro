---
// CompressionResultsTable.astro
//
// Per-version compression results from the in-progress ReadonlyREST
// builds migration. Verified, SHA-256 round-tripped, publishable today.
//
// Used on /saas and /case-studies/readonlyrest-builds — keeping them
// in sync via this component prevents the copy-paste drift the
// hygiene reviewer flagged.
//
// The migration is complete; the total row carries the measured result.
// update the `rows` array below and the "Full migration" TBD row.

interface Props {
  /**
   * Whether to include the parenthetical context labels
   * ("warm-path", "cold from Glacier", etc.). Default true.
   * Set false for compact rendering.
   */
  detailed?: boolean;
  /** Whether to include the "Full migration" in-progress placeholder row. */
  includeTotalRow?: boolean;
}

const { detailed = true, includeTotalRow = true } = Astro.props;

// Verdict grade chip: recognised grades render as a small tag, the rest
// of the verdict stays plain text.
const gradeOf = (v: string) => v.match(/^(Excellent|Fair|Complete)/)?.[1];
const noteOf = (v: string) => v.replace(/^(Excellent|Fair|Complete)\s*/, '').replace(/^\((.*)\)$/, '$1');

interface Row {
  version: string;
  variant?: string;
  sourceSize: string;
  storedSize: string;
  compression: string;
  verdict: string;
}

const rows: Row[] = [
  {
    version: '1.69.0',
    variant: 'warm-path',
    sourceSize: '2,866 MB',
    storedSize: '32.4 MB',
    compression: '98.9%',
    verdict: 'Excellent',
  },
  {
    version: '1.38.0',
    variant: 'warm-path, multi-shape',
    sourceSize: '13.7 GB',
    storedSize: '3.3 GB',
    compression: '75.6%',
    verdict: 'Fair (cross-major ES range)',
  },
  {
    version: '1.17.1',
    variant: 'cold from Glacier',
    sourceSize: '26 MB',
    storedSize: '6.8 MB',
    compression: '74.0%',
    verdict: 'Small dataset, dominated by reference',
  },
];
---

<div class="table-scroll">
<table class="compact-table">
  <thead>
    <tr>
      <th>Version</th>
      <th>Size (Encrypted)</th>
      <th>Verdict</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((r) => (
        <tr>
          <td>
            <strong>{r.version}</strong>
            {detailed && r.variant ? <div class="variant-label">{r.variant}</div> : ''}
          </td>
          <td>
            <div class="size-flow">
              <span class="src-size">{r.sourceSize}</span>
              <span class="arrow">→</span>
              <span class="dst-size">{r.storedSize}</span>
              <span class="compression-badge">-{r.compression}</span>
            </div>
          </td>
          <td class="verdict-cell">
            {gradeOf(r.verdict) ? (
              <>
                <span class={`grade grade--${gradeOf(r.verdict)!.toLowerCase()}`}>{gradeOf(r.verdict)}</span>
                {noteOf(r.verdict) && <span class="verdict-note">{noteOf(r.verdict)}</span>}
              </>
            ) : (
              <span class="verdict-note">{r.verdict}</span>
            )}
          </td>
        </tr>
      ))
    }
    {
      includeTotalRow && (
        <tr class="total-row">
          <td>
            <strong>Full migration</strong>
            {detailed && <div class="variant-label">174 versions</div>}
          </td>
          <td>
            <div class="size-flow">
              <span class="src-size">1.71 TB</span>
              <span class="arrow">→</span>
              <span class="dst-size">134 GB</span>
            </div>
          </td>
          <td class="verdict-cell">
            <span class="grade grade--complete">Complete</span>
          </td>
        </tr>
      )
    }
  </tbody>
</table>
</div>

<style>
  /* Wide tables scroll inside their own container; the page never
     scrolls horizontally. */
  .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 1.75rem 0;
  }

  .compact-table {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
    font-size: 0.95rem;
    margin: 0;
  }
  
  .compact-table th {
    text-align: left;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-soft);
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    font-weight: 600;
    background: var(--surface-tint);
  }

  .compact-table td {
    padding: 1.05rem 1.25rem;
    border-bottom: 1px solid var(--rule);
    vertical-align: middle;
  }

  .compact-table th:first-child,
  .compact-table td:first-child {
    width: 22%;
  }

  .compact-table th:last-child,
  .compact-table td:last-child {
    width: 34%;
  }

  .compact-table tr:last-child td {
    border-bottom: none;
  }

  .verdict-cell {
    line-height: 1.45;
  }

  .grade {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--rule-strong);
    color: var(--ink-soft);
  }

  .grade--excellent,
  .grade--complete {
    color: var(--brand);
    border-color: var(--brand-line);
    background: var(--brand-tint);
  }

  .verdict-note {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .total-row strong {
    white-space: nowrap;
  }

  .total-row td {
    background: var(--brand-tint);
    border-top: 2px solid var(--brand-line);
  }

  .total-row .dst-size {
    color: var(--brand);
  }

  .variant-label {
    display: block;
    font-size: 0.8rem;
    color: var(--ink-faint);
    margin-top: 0.25rem;
  }

  .size-flow {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    gap: 0.5rem;
    background: var(--surface-tint);
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    border: 1px solid var(--rule);
  }

  .src-size {
    color: var(--ink-soft);
    text-decoration: line-through;
    font-family: var(--font-mono);
  }

  .arrow {
    color: var(--ink-faint);
  }

  .dst-size {
    color: var(--ink-strong);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .compression-badge {
    background: var(--brand-soft);
    color: var(--brand);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 700;
    margin-left: 0.25rem;
  }
</style>
