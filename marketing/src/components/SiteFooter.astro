---
// SiteFooter.astro — the site-wide footer, on every page.
// Link columns come from src/lib/nav.ts (shared with the header).
// Owns its own chrome: gradient base, drifting aurora, top seam.

import BrandMark from './BrandMark.astro';
import { FOOTER_COLUMNS } from '../lib/nav';
---

<footer class="site-footer" aria-label="Footer">
  <div class="footer-grid">
    <div class="footer-brand">
      <div class="footer-brand-row">
        <BrandMark />
        <span>DeltaGlider</span>
      </div>
      <p class="footer-tagline">
        The object storage control plane, behind the same S3 API.
        Source-available (BUSL-1.1).
      </p>
    </div>

    {FOOTER_COLUMNS.map((col) => (
      <div class="footer-col">
        <h2 class="footer-col-title">{col.title}</h2>
        <ul>
          {col.links.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="footer-bottom">
    <span>© Beshu Limited · BUSL-1.1 · London, UK</span>
    <span>
      Made by Beshu Tech engineers with Claude as a coding aid. Each
      <a href="https://github.com/beshu-tech/deltaglider_proxy/commits/main">co-authored commit</a> names the model.
    </span>
    <span>
      A managed cloud is under consideration.
      <a href="mailto:contact@beshu.tech?subject=DeltaGlider%20-%20Managed%20cloud%20interest">Email us</a> if you want one.
    </span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 0;
    padding: 3.5rem 0 2rem 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
    position: relative;
    overflow: hidden;
    /* One flat surface and one rule: the footer is the quietest block. */
    background: var(--footer-bg-1);
    border-top: 1px solid var(--rule);
  }

  .site-footer a {
    color: var(--ink-700);
    text-decoration: none;
    border-bottom: 1px dotted var(--ink-400);
    transition: color 0.15s, border-color 0.15s;
  }

  .site-footer a:hover {
    color: var(--brand-dark);
    border-bottom-color: var(--brand);
  }

  .footer-grid {
    max-width: var(--shell);
    margin: 0 auto;
    padding: 0 1.25rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 768px) {
    .footer-grid {
      padding: 0 2rem;
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }

  .footer-brand-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    color: var(--ink-strong);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }

  /* brand bolt gets a gentle glow so the colour reads as alive */
  .footer-brand-row :global(.brand-mark) {
  }

  .footer-tagline {
    color: var(--ink-soft);
    font-size: 0.85rem;
    line-height: 1.5;
    max-width: 28ch;
    margin: 0.5rem 0 0 0;
  }

  .footer-col-title {
    font-weight: 700;
    color: var(--ink-700);
    font-size: var(--fs-small);
    margin: 0 0 0.85rem 0;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-col li {
    margin: 0.4rem 0;
  }

  .footer-bottom {
    max-width: var(--shell);
    margin: 2.5rem auto 0 auto;
    padding: 1.5rem 1.25rem 0 1.25rem;
    border-top: 1px solid var(--rule);
    font-size: 0.8rem;
    color: var(--ink-mute);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      padding: 1.5rem 2rem 0 2rem;
    }
  }

  /* Phones: two link columns, 44 px rows, and no text under 14 px. */
  @media (max-width: 767px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.75rem 1.25rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-tagline {
      font-size: 0.95rem;
      max-width: none;
    }

    .footer-col-title {
      font-size: 0.8rem;
      margin-bottom: 0.25rem;
    }

    .footer-col li {
      margin: 0;
    }

    .site-footer a {
      border-bottom: none;
      text-decoration: underline dotted var(--ink-400);
      text-underline-offset: 0.25em;
    }

    .footer-col a {
      display: inline-block;
      padding: 0.7rem 0;
    }

    .footer-bottom {
      font-size: 0.875rem;
    }
  }
</style>
